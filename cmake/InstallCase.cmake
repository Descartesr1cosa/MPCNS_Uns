# `cmake --install <build> --prefix <work-dir>`  ->  <work-dir>/CASE/NN_Step/ : programs + input templates for ONE model.
#   -DUNS_CASE_MODEL=Mercury|Mars   (cache variable, default Mercury; install.sh <work-dir> [Mercury|Mars])
# Input files (config.yml, *.txt) that already exist in the target are NOT overwritten (your edits survive a re-install);
# programs are always refreshed.  Everything but MPI is statically linked: the only runtime dependency is the MPI library
# (found through the embedded RPATH).  Templates live in case_template/ (single copy of every parameter file).
set(UNS_CASE_MODEL "Mercury" CACHE STRING "Model of the CASE folder created by install: Mercury | Mars")
set_property(CACHE UNS_CASE_MODEL PROPERTY STRINGS Mercury Mars)
set(UNS_CASE_NAME "CASE" CACHE STRING "Name of the case folder created by install inside the prefix")

if(CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
  set(CMAKE_INSTALL_PREFIX "${CMAKE_BINARY_DIR}/work" CACHE PATH "Work directory: the CASE folder is created in here" FORCE)
endif()

set(_t "${PROJECT_SOURCE_DIR}/case_template")
set(_c "${UNS_CASE_NAME}")

# copy the files of a template folder that are not there yet (never overwrite the user's inputs)
function(uns_case_inputs src dest)
  install(CODE "
    file(GLOB_RECURSE _f RELATIVE \"${src}\" \"${src}/*\")
    foreach(_r IN LISTS _f)
      set(_d \"\${CMAKE_INSTALL_PREFIX}/${dest}/\${_r}\")
      if(EXISTS \"\${_d}\")
        message(STATUS \"Kept existing: \${_d}\")
      else()
        get_filename_component(_dir \"\${_d}\" DIRECTORY)
        file(MAKE_DIRECTORY \"\${_dir}\")
        file(COPY \"${src}/\${_r}\" DESTINATION \"\${_dir}\")
        message(STATUS \"Installing: \${_d}\")
      endif()
    endforeach()")
endfunction()
function(uns_case_file file dest rename)
  install(CODE "
    set(_d \"\${CMAKE_INSTALL_PREFIX}/${dest}/${rename}\")
    if(EXISTS \"\${_d}\")
      message(STATUS \"Kept existing: \${_d}\")
    else()
      file(COPY_FILE \"${file}\" \"\${_d}\")
      message(STATUS \"Installing: \${_d}\")
    endif()")
endfunction()

if(UNS_CASE_MODEL STREQUAL "Mercury")
  if(NOT TARGET MercuryUns)
    message(FATAL_ERROR "UNS_CASE_MODEL=Mercury needs MPI (MercuryUns target missing)")
  endif()
  set(_m "${_t}/Mercury")
  foreach(d 01_Meshgen 02_MercuryRun 03_MercuryRefine 04_MercuryRunFine)
    uns_case_inputs(${_m}/${d} ${_c}/${d})
  endforeach()
  uns_case_file(${_t}/common/partition.txt ${_c}/01_Meshgen partition.txt)
  install(TARGETS mpcns_pre RUNTIME DESTINATION ${_c}/01_Meshgen)
  install(TARGETS mpcns_pre RUNTIME DESTINATION ${_c}/03_MercuryRefine)
  install(TARGETS MercuryUns RUNTIME DESTINATION ${_c}/02_MercuryRun)
  install(TARGETS MercuryUns RUNTIME DESTINATION ${_c}/04_MercuryRunFine)
elseif(UNS_CASE_MODEL STREQUAL "Mars")
  if(NOT TARGET MarsUns)
    message(FATAL_ERROR "UNS_CASE_MODEL=Mars needs MPI (MarsUns target missing)")
  endif()
  set(_m "${_t}/Mars")
  foreach(d 01_Meshgen 02_MarsRun)
    uns_case_inputs(${_m}/${d} ${_c}/${d})
  endforeach()
  uns_case_file(${_t}/common/partition.txt ${_c}/01_Meshgen partition.txt)
  install(TARGETS mpcns_pre RUNTIME DESTINATION ${_c}/01_Meshgen)
  install(TARGETS MarsUns RUNTIME DESTINATION ${_c}/02_MarsRun)
else()
  message(FATAL_ERROR "UNS_CASE_MODEL must be Mercury or Mars")
endif()
uns_case_file(${_t}/README.md ${_c} README.md)
install(CODE "message(STATUS \"CASE (${UNS_CASE_MODEL}) ready: \${CMAKE_INSTALL_PREFIX}/${_c} -- read ${_c}/README.md, start in 01_Meshgen with ./mpcns_pre\")")
